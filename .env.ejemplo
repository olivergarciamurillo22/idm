# Copiar a .env y rellenar. El fichero .env NO se sube a git.

# Rutas (relativas al repositorio o absolutas)
RUTA_DATOS=datos
RUTA_ENTRADA=datos/entrada
RUTA_PROCESADOS=datos/procesados
RUTA_SIDDEX=datos/siddex
RUTA_PLANNING=datos/planning/PLANNING_IDM_MENSUAL.xlsx
RUTA_PEDIDOS_PDF=datos/pedidos
RUTA_SALIDA=datos/salida
# Carpeta real de IDM donde se copian los PDF de pedido (vacío = no copiar)
RUTA_PEDIDOS_TRANSMITIDOS=

# Base de datos (SQLite local; PostgreSQL cambiando la URL)
DATABASE_URL=sqlite:///datos/idm.db

# Modo simulación: true = no envía correos ni escribe fuera de datos/
MODO_SIMULACION=true

# Empresa (cabecera de los PDF de pedido)
EMPRESA_NOMBRE=IDM
EMPRESA_DIRECCION=
EMPRESA_CIF=
EMPRESA_TELEFONO=
EMPRESA_EMAIL_PEDIDOS=

# Correo saliente (pedidos)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# Buzones IMAP donde entran albaranes y facturas (separados por ; )
# formato: host|usuario|clave|carpeta
IMAP_BUZONES=

# Bandeja web
BANDEJA_HOST=0.0.0.0
BANDEJA_PUERTO=8000

# ---------------------------------------------------------------------------------------------------------------
# LECTURA DOCUMENTAL (fotos y escaneos). Ver docs/DOCUMENT-PROVIDERS.md
# ---------------------------------------------------------------------------------------------------------------
# Motor que lee fotos y PDF escaneados: ninguno | tesseract | azure | mistral | benchmark
# (los PDF con texto se leen siempre en local con pdfplumber)
DOCUMENT_PROVIDER=ninguno
# Respaldo solo si el principal falla técnicamente. Vacío = el documento queda pendiente de reintento.
DOCUMENT_PROVIDER_FALLBACK=
# Con DOCUMENT_PROVIDER=benchmark: el primero lee, los demás se ejecutan para comparar
DOCUMENT_PROVIDERS_BENCHMARK=tesseract

# PRIVACIDAD. Mientras sea false, ningún documento sale de esta máquina (Azure/Mistral/Google se rechazan).
# Solo pasar a true cuando IDM confirme por escrito que los documentos pueden procesarse fuera.
ALLOW_EXTERNAL_DOCUMENT_PROCESSING=false
# Además, cada proveedor externo hay que autorizarlo aquí uno a uno (separados por coma), p. ej.: mistral
EXTERNAL_DOCUMENT_PROVIDERS_ALLOWED=

# Mistral OCR (https://console.mistral.ai -> API Keys). PEGA TU CLAVE DESPUÉS DEL =
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
# Confianza por palabra: word | page | none (si Mistral rechaza el parámetro con tu modelo, pon none)
MISTRAL_OCR_CONFIDENCE=word
# Anotación estructurada de campos (coste aparte): false por defecto
MISTRAL_DOCUMENT_ANNOTATION=false

# Azure AI Document Intelligence (portal de Azure -> recurso Document Intelligence -> Claves y punto de conexión)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_FEATURES=keyValuePairs

# Tarifas (vacío = src/idm/documental/tarifas.json, fechadas y orientativas), tiempos y reintentos
DOCUMENT_PRICING_FILE=
DOCUMENT_PROVIDER_TIMEOUT_S=120
DOCUMENT_PROVIDER_MAX_RETRIES=3

# Tesseract local (respaldo/benchmark): tuberías y idioma
OCR_TUBERIA=contraste_3200,recorte_3200
OCR_LANG=spa+eng

