# Copiar a .env y rellenar. El fichero .env NO se sube a git.

# Rutas (relativas al repositorio o absolutas)
RUTA_DATOS=datos
RUTA_ENTRADA=datos/entrada
RUTA_PROCESADOS=datos/procesados
RUTA_SIDDEX=datos/siddex
RUTA_PLANNING=datos/planning/PLANNING_IDM_MENSUAL.xlsx
RUTA_PEDIDOS_PDF=datos/pedidos
RUTA_SALIDA=datos/salida
# Carpeta real de IDM donde se copian los PDF de pedido (vacío = no copiar)
RUTA_PEDIDOS_TRANSMITIDOS=

# Base de datos (SQLite local; PostgreSQL cambiando la URL)
DATABASE_URL=sqlite:///datos/idm.db

# Modo simulación: true = no envía correos ni escribe fuera de datos/
MODO_SIMULACION=true

# Empresa (cabecera de los PDF de pedido)
EMPRESA_NOMBRE=IDM
EMPRESA_DIRECCION=
EMPRESA_CIF=
EMPRESA_TELEFONO=
EMPRESA_EMAIL_PEDIDOS=

# Correo saliente (pedidos)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# Buzones IMAP donde entran albaranes y facturas (separados por ; )
# formato: host|usuario|clave|carpeta
IMAP_BUZONES=

# Bandeja web
BANDEJA_HOST=0.0.0.0
BANDEJA_PUERTO=8000

# OCR local para fotos y escaneos (nada sale de la máquina). ninguno = las fotos quedan REQUIERE_OCR para teclear.
# tesseract requiere el programa instalado (Windows: instalador UB Mannheim; Mac: brew install tesseract) con idioma spa.
OCR_MOTOR=ninguno
OCR_TUBERIA=contraste_3200,recorte_3200
OCR_LANG=spa+eng
